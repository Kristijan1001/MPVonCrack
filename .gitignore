# ─── SECRETS — never commit ───────────────────────────────────────────────
# Your API tokens live here. The .example files are what ship.
portable_config/script-opts/realdebrid.conf
portable_config/script-opts/torbox.conf
*.token
.env

# ─── Too big for a git repo ───────────────────────────────────────────────
# The NVIDIA CUDA / TensorRT runtime. 3.2 GB, and 11 of its DLLs are over
# GitHub's hard 100 MB per-file limit (cublasLt64_13.dll alone is 458 MB), so
# it physically cannot live here. It ships as a separate Release asset.
vs-plugins/vsmlrt-cuda/

# ─── GPU-specific build artifacts ─────────────────────────────────────────
# TensorRT compiles these for one exact GPU + driver + TensorRT version, so
# they are useless on any other machine and are rebuilt automatically on first
# use. ~1.5 GB combined. Note *.engine.cache does NOT match "*.engine".
*.engine
*.engine.cache

# ─── Runtime state / caches ───────────────────────────────────────────────
portable_config/_cache/
portable_config/watch_later/
portable_config/saved-props.json
_cache/
*.log

# Debrid caches + generated session playlists
rd_torrent_cache.json
magnet_rd_cache.json
tb_torrent_cache.json
mpv_rd_session_*.m3u8
mpv_tb_session_*.m3u8
strm_playlist_*.m3u8

# ─── Junk ─────────────────────────────────────────────────────────────────
portable_config/OLD/
Thumbs.db
desktop.ini
.tmp.driveupload/
.tmp.drivedownload/
__pycache__/
*.pyc
